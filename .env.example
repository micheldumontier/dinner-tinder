# Copy to .env to point the client at the real DinnerMatch backend.
# Leave unset (or remove .env) to use the localStorage mock backend instead.
#
# Start the server with `npm run server` (defaults to port 8787), then choose:
#
#   VITE_API_URL=http://localhost:8787   # one fixed URL for everyone
#   VITE_API_URL=auto                    # derive from page hostname at runtime
#
# `auto` lets one dev server work for both the host (via localhost) and phones
# on the LAN (via the LAN IP) without rebuilding. `npm run dev:lan` already
# sets this for you.
VITE_API_URL=http://localhost:8787
